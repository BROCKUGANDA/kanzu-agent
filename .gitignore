# ── Model weights — never commit these (ADTC rule 2) ─────────────────────────
model/*.gguf
model/*.gguf.partial
model/*.bin
model/*.safetensors

# ── Profiler / benchmark output ───────────────────────────────────────────────
# NOTE: submission.json is version-controlled (it is the profiler's submission
# record and is kept in sync with metadata.json by the CI metadata step; its
# docker_image_digest is patched by .github/workflows/docker.yml on push to
# main). audit.json / verdict.json are local-only profiler artefacts.
# submission.json
audit.json
verdict.json
bench/*.json
bench/*.log

# ── Kanzu runtime state (rebuildable from fixtures + knowledge/) ──────────────
# The SQLite ledger and per-inference prompt logs are local runtime artefacts.
var/kanzu.db*
var/prompts/prompt-[0-9]*.txt
# The six versioned system prompts (prompt-{narration,planning}-{en,sw,lg}.txt)
# ARE committed so the Dockerfile COPY var/prompts/ works in CI.
*.db
*.db-shm
*.db-wal
data/kanzu.db*

# ── Go build artefacts ───────────────────────────────────────────────────────
bin/
dist/
kanzu
kanzu.exe
*.test
*.out
coverage.txt

# ── Offline fine-tuning workspace (never part of the shipped artefact) ────────
training/.venv/
training/out/
training/checkpoints/
training/*.jsonl
training/llama.cpp/

# ── Third-party toolchain fetched by scripts/setup_llama_cpp.sh ───────────────
vendor/llama.cpp/
.tools/

# ── Python (profiler venv) ───────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.uv-cache/

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
